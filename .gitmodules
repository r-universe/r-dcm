[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "S7"]
	path = S7
	url = https://github.com/RConsortium/S7
	registered = false
[submodule "dcmdata"]
	path = dcmdata
	url = https://github.com/r-dcm/dcmdata
[submodule "dcmstan"]
	path = dcmstan
	url = https://github.com/r-dcm/dcmstan
[submodule "measr"]
	path = measr
	url = https://github.com/r-dcm/measr
[submodule "rdcmchecks"]
	path = rdcmchecks
	url = https://github.com/r-dcm/rdcmchecks
